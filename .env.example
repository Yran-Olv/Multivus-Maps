# Valores apenas para desenvolvimento local. Troque todos antes de qualquer deploy.

POSTGRES_USER=multivus
POSTGRES_PASSWORD=multivus_dev
POSTGRES_DB=multivus_maps
DATABASE_URL=postgres://multivus:multivus_dev@localhost:5432/multivus_maps

REDIS_URL=redis://localhost:6379

# Gere com: openssl rand -base64 48
JWT_ACCESS_SECRET=replace-with-a-long-random-string
JWT_REFRESH_SECRET=replace-with-another-long-random-string

CORS_ORIGIN=http://localhost:5173
API_HOST=0.0.0.0
API_PORT=3333

# Usado só pelo seed. Não reutilize esta senha fora da sua máquina.
ADMIN_EMAIL=admin@multivus.local
ADMIN_PASSWORD=change-me
ADMIN_NAME=Administrador

# Vazio usa o mesmo domínio (/api). No Capacitor, aponte para a URL pública da API.
VITE_API_URL=
